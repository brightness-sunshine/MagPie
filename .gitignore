# Python
__pycache__/
*.py[cod]
.venv/

# Runtime data: never publish real user bookmarks or caches
data/magpie.sqlite3*
data/raw/**
data/cache/**
data/index/**
data/exports/**
!data/raw/x/.gitkeep
!data/exports/.gitkeep
data/normalized/x/bookmarks.jsonl
data/normalized/x/bookmarks.latest.json
# generated from real bookmarks by magpie_digest.py — never commit it
data/normalized/x/digest.latest.md
!data/normalized/x/bookmarks.sample.jsonl
!data/normalized/x/bookmarks.latest.sample.json

# Local secrets and environment
.env
*.env
